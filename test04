
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <ctype.h>

#define MAX_DATA 32
#define MAX_LINE 4096

/* ---------- 이진트리 노드 (연결 자료구조) ---------- */
typedef struct Node {
    char data[MAX_DATA];
    struct Node *left;
    struct Node *right;
} Node;

static Node *new_node(const char *data) {
    Node *n = (Node *)malloc(sizeof(Node));
    if (!n) { fprintf(stderr, "메모리 할당 실패\n"); exit(1); }
    strncpy(n->data, data, MAX_DATA - 1);
    n->data[MAX_DATA - 1] = '\0';
    n->left = n->right = NULL;
    return n;
}

/* ---------- 스택 (노드 포인터 + 보조 정수값) ---------- */
typedef struct {
    Node *node;
    int   aux;      /* 파서: 상태, 출력: 깊이 */
} Item;

typedef struct {
    Item *items;
    int top, cap;
} Stack;

static void st_init(Stack *s) {
    s->cap = 16; s->top = 0;
    s->items = (Item *)malloc(sizeof(Item) * s->cap);
    if (!s->items) { fprintf(stderr, "메모리 할당 실패\n"); exit(1); }
}
static void st_free(Stack *s) { free(s->items); s->items = NULL; }
static int  st_empty(const Stack *s) { return s->top == 0; }
static void st_push(Stack *s, Node *n, int aux) {
    if (s->top == s->cap) {
        s->cap *= 2;
        s->items = (Item *)realloc(s->items, sizeof(Item) * s->cap);
        if (!s->items) { fprintf(stderr, "메모리 할당 실패\n"); exit(1); }
    }
    s->items[s->top].node = n;
    s->items[s->top].aux  = aux;
    s->top++;
}
static Item st_pop(Stack *s) { return s->items[--s->top]; }
static Item *st_peek(Stack *s) { return &s->items[s->top - 1]; }

/* ---------- 메모리 해제 (반복적) ---------- */
static void free_tree(Node *root) {
    if (!root) return;
    Stack s; st_init(&s);
    st_push(&s, root, 0);
    while (!st_empty(&s)) {
        Node *n = st_pop(&s).node;
        if (n->left)  st_push(&s, n->left, 0);
        if (n->right) st_push(&s, n->right, 0);
        free(n);
    }
    st_free(&s);
}

/* ---------- 괄호 표기법 파서 (반복적, 스택 사용) ----------
 * 스택 항목: node = 현재 부모 노드
 *            aux  = 상태 비트 (bit0: 지금 오른쪽 차례인가, bit1: 자식이 하나라도 붙었는가)
 * 오류가 있으면 msg에 메시지를 채우고 NULL 반환.
 */
static Node *parse_tree(const char *src, char *msg, size_t msglen) {
    Node *root = NULL;
    Stack st; st_init(&st);
    int prev_name = 0;          /* 직전 토큰이 노드 이름이었는가 */
    Node *last = NULL;          /* 직전에 만든 노드 */
    int count = 0;
    const char *p = src;

#define FAIL(...) do { snprintf(msg, msglen, __VA_ARGS__); \
                       free_tree(root); st_free(&st); return NULL; } while (0)

    while (*p) {
        if (isspace((unsigned char)*p)) { p++; continue; }

        if (isalnum((unsigned char)*p)) {
            char buf[MAX_DATA]; int len = 0;
            long pos = (long)(p - src) + 1;
            while (isalnum((unsigned char)*p)) {
                if (len >= MAX_DATA - 1) FAIL("노드 데이터가 너무 깁니다 (위치 %ld).", pos);
                buf[len++] = *p++;
            }
            buf[len] = '\0';
            if (prev_name) FAIL("노드 사이에 ',' 또는 괄호가 필요합니다 (위치 %ld).", pos);

            Node *n = new_node(buf);
            if (st_empty(&st)) {
                if (root) { free(n); FAIL("루트가 둘 이상이거나 닫는 괄호 뒤에 불필요한 데이터가 있습니다 (위치 %ld).", pos); }
                root = n;
            } else {
                Item *top = st_peek(&st);
                Node **slot = (top->aux & 1) ? &top->node->right : &top->node->left;
                if (*slot) { free(n); FAIL("자식 위치가 중복되었습니다 (위치 %ld).", pos); }
                *slot = n;
                top->aux |= 2;
            }
            last = n; prev_name = 1; count++;
            continue;
        }

        long pos = (long)(p - src) + 1;
        switch (*p) {
        case '(':
            if (!prev_name) FAIL("'(' 앞에는 노드 데이터가 있어야 합니다 (위치 %ld).", pos);
            st_push(&st, last, 0);
            prev_name = 0;
            break;
        case ',':
            if (st_empty(&st)) FAIL("괄호 밖에 ',' 가 있습니다 (위치 %ld).", pos);
            if (st_peek(&st)->aux & 1) FAIL("한 노드에 자식이 3개 이상입니다 (위치 %ld).", pos);
            st_peek(&st)->aux |= 1;
            prev_name = 0;
            break;
        case ')':
            if (st_empty(&st)) FAIL("짝이 맞지 않는 ')' 입니다 (위치 %ld).", pos);
            if (!(st_peek(&st)->aux & 2)) FAIL("자식이 하나도 없는 빈 괄호입니다 (위치 %ld).", pos);
            st_pop(&st);
            prev_name = 0;
            break;
        default:
            FAIL("허용되지 않는 문자 '%c' 입니다 (위치 %ld).", *p, pos);
        }
        p++;
    }

    if (!st_empty(&st)) FAIL("닫히지 않은 '(' 가 있습니다.");
    if (!root)          FAIL("입력된 트리가 없습니다.");
    (void)count;
    st_free(&st);
    return root;
#undef FAIL
}

/* ---------- 트리 구조 출력 (오른쪽이 위, 왼쪽이 아래로 눕혀서 출력) ---------- */
static void print_tree(Node *root) {
    Stack s; st_init(&s);
    Node *cur = root; int depth = 0;
    while (cur || !st_empty(&s)) {
        while (cur) {                    /* 오른쪽 끝까지 내려감 */
            st_push(&s, cur, depth);
            cur = cur->right; depth++;
        }
        Item it = st_pop(&s);
        for (int i = 0; i < it.aux; i++) printf("    ");
        printf("%s\n", it.node->data);
        cur = it.node->left; depth = it.aux + 1;
    }
    st_free(&s);
}

/* ---------- 반복적 순회 ---------- */

/* 전위: Root -> Left -> Right */
void preorder(Node *tree) {
    if (!tree) return;
    Stack s; st_init(&s);
    st_push(&s, tree, 0);
    while (!st_empty(&s)) {
        Node *n = st_pop(&s).node;
        printf("%s ", n->data);                 /* 방문 */
        if (n->right) st_push(&s, n->right, 0); /* 오른쪽을 먼저 넣어야 왼쪽이 먼저 나옴 */
        if (n->left)  st_push(&s, n->left, 0);
    }
    st_free(&s);
}

/* 중위: Left -> Root -> Right */
void inorder(Node *tree) {
    Stack s; st_init(&s);
    Node *cur = tree;
    while (cur || !st_empty(&s)) {
        while (cur) {                           /* 왼쪽 끝까지 내려감 */
            st_push(&s, cur, 0);
            cur = cur->left;
        }
        cur = st_pop(&s).node;
        printf("%s ", cur->data);               /* 방문 */
        cur = cur->right;
    }
    st_free(&s);
}

/* 후위: Left -> Right -> Root  (직전에 방문한 노드를 기억하는 방식) */
void postorder(Node *tree) {
    Stack s; st_init(&s);
    Node *cur = tree, *last = NULL;
    while (cur || !st_empty(&s)) {
        if (cur) {
            st_push(&s, cur, 0);
            cur = cur->left;
        } else {
            Node *top = st_peek(&s)->node;
            if (top->right && top->right != last) {
                cur = top->right;               /* 오른쪽 서브트리가 남아 있음 */
            } else {
                printf("%s ", top->data);       /* 방문 */
                last = top;
                st_pop(&s);
            }
        }
    }
    st_free(&s);
}

/* ---------- main ---------- */
int main(int argc, char *argv[]) {
    char line[MAX_LINE];
    char msg[256];

    if (argc >= 2) {                            /* 인자로 트리를 줄 수도 있음 */
        strncpy(line, argv[1], MAX_LINE - 1);
        line[MAX_LINE - 1] = '\0';
    } else {
        printf("괄호 표기법으로 이진트리를 입력하세요.\n");
        printf("예) A(B(D,E),C(,F))\n> ");
        if (!fgets(line, sizeof(line), stdin)) {
            fprintf(stderr, "[오류] 입력을 읽을 수 없습니다.\n");
            return 1;
        }
    }

    Node *root = parse_tree(line, msg, sizeof(msg));
    if (!root) {
        fprintf(stderr, "[오류] 잘못된 괄호 표현입니다: %s\n", msg);
        return 1;
    }

    printf("\n입력한 트리: ");
    for (const char *p = line; *p && *p != '\n'; p++)
        if (!isspace((unsigned char)*p)) putchar(*p);
    printf("\n\n[이진트리 구조] (오른쪽 자식이 위, 왼쪽 자식이 아래)\n");
    print_tree(root);

    printf("\nPreorder  : "); preorder(root);  printf("\n");
    printf("Inorder   : ");   inorder(root);   printf("\n");
    printf("Postorder : ");   postorder(root); printf("\n");

    free_tree(root);
    return 0;
}
